From 7d05289730d636847da099369d18088d0d4f5124 Mon Sep 17 00:00:00 2001
From: Flominator <github.flominatorgd@gmail.com>
Date: Thu, 22 Oct 2026 21:33:17 +0000
Subject: [PATCH] Don't abort when real-time scheduling is unavailable

On Samsung Exynos 7870 devices (such as SM-A320FL a3y17lte) running on
3.18 kernels, the Bluetooth UID may not use real-time priority (no
CAP_SYS_NICE and RLIMIT_RTPRIO == 0), so attempts to switch to
SCHED_FIFO fail with EPERM. Scheduling priority is a best-effort latency
optimization rather than a correctness requirement:

1) osi/alarm: timer_create_internal() creates a POSIX timer with a
   SIGEV_THREAD notification thread carrying explicit SCHED_FIFO
   attributes, which fails on 64-bit Bionic with EPERM and aborts the
   stack in alarm_new(). Retry timer_create() with default thread
   attributes when the RT attempt fails.

2) EnableRealTimeScheduling() callers: downgrade log::fatal() to
   log::error() in main_thread.cc, btif_a2dp_sink.cc,
   btif_a2dp_source.cc, and LE Audio audio_source_hal_client.cc so
   Bluetooth startup and A2DP/BLE audio streaming do not abort.

Forward-ported from lineage-20 commit 33c80651068c to LineageOS 24.0.

Co-authored-by: Pierre-Hugues Husson <phh@phh.me>
Signed-off-by: Flominator <github.flominatorgd@gmail.com>
---
 .../audio_hal_client/audio_source_hal_client.cc |  2 +-
 system/btif/src/btif_a2dp_sink.cc               |  2 +-
 system/btif/src/btif_a2dp_source.cc             |  2 +-
 system/osi/src/alarm.cc                         | 17 +++++++++++++++++
 system/stack/btu/main_thread.cc                 |  2 +-
 5 files changed, 21 insertions(+), 4 deletions(-)

diff --git a/system/bta/le_audio/audio_hal_client/audio_source_hal_client.cc b/system/bta/le_audio/audio_hal_client/audio_source_hal_client.cc
index 2d2d4010c017adf78d65104cca336fe60dd6977a..72cb17f96cceab605fbefa410164c10408e20dd0 100644
--- a/system/bta/le_audio/audio_hal_client/audio_source_hal_client.cc
+++ b/system/bta/le_audio/audio_hal_client/audio_source_hal_client.cc
@@ -258,7 +258,7 @@ bool SourceImpl::InitAudioSinkThread() {
   /* Schedule the rest of the operations */
   if (!worker_thread_->EnableRealTimeScheduling()) {
 #if defined(__ANDROID__)
-    log::fatal("Failed to increase media thread priority");
+    log::error("Failed to increase media thread priority");
 #endif
   }
 
diff --git a/system/btif/src/btif_a2dp_sink.cc b/system/btif/src/btif_a2dp_sink.cc
index e329f6c4af49a6f37e6a66016019ab4501122f13..c12ea752286eceb150a641bfde4f2c0b1e2ea4e4 100644
--- a/system/btif/src/btif_a2dp_sink.cc
+++ b/system/btif/src/btif_a2dp_sink.cc
@@ -170,7 +170,7 @@ bool btif_a2dp_sink_init() {
   /* Schedule the rest of the operations */
   if (!btif_a2dp_sink_cb.worker_thread.EnableRealTimeScheduling()) {
 #if defined(__ANDROID__)
-    log::fatal("Failed to increase A2DP decoder thread priority");
+    log::error("Failed to increase A2DP decoder thread priority");
 #endif
   }
   btif_a2dp_sink_cb.worker_thread.DoInThread(base::BindOnce(btif_a2dp_sink_init_delayed));
diff --git a/system/btif/src/btif_a2dp_source.cc b/system/btif/src/btif_a2dp_source.cc
index d9a14021e894caa737bf91ef41056765867aa13c..b9030690b6d4cc34cf40800475956891fa2a00a3 100644
--- a/system/btif/src/btif_a2dp_source.cc
+++ b/system/btif/src/btif_a2dp_source.cc
@@ -325,7 +325,7 @@ bool btif_a2dp_source_init(void) {
 
   if (!btif_a2dp_source_thread.EnableRealTimeScheduling()) {
 #if defined(__ANDROID__)
-    log::fatal("unable to enable real time scheduling");
+    log::error("unable to enable real time scheduling");
 #endif
   }
 
diff --git a/system/osi/src/alarm.cc b/system/osi/src/alarm.cc
index f3468afb7d8caac67f26e2a3bf265de1f933187a..3d5d5e8d8d857f151c9c209fe34c35657aa9ed06 100644
--- a/system/osi/src/alarm.cc
+++ b/system/osi/src/alarm.cc
@@ -686,6 +686,23 @@ static bool timer_create_internal(const clockid_t clock_id, timer_t* timer) {
   sigevent.sigev_notify_function = timer_callback;
   sigevent.sigev_notify_attributes = &thread_attr;
   if (timer_create(clock_id, &sigevent, timer) == -1) {
+    // Bionic implements SIGEV_THREAD timers on top of a pthread created with
+    // the supplied attributes. On 64-bit, pthread_create() propagates the
+    // error when the requested real-time scheduling policy may not be used
+    // (no CAP_SYS_NICE and RLIMIT_RTPRIO == 0, i.e. EPERM), so the timer is
+    // never created, lazy_initialize() fails and alarm_new() aborts the
+    // entire Bluetooth stack. Retry with default thread attributes first.
+    log::warn("unable to create timer with clock {} and RT thread attributes: {}. "
+              "Retrying with default thread attributes.", clock_id, strerror(errno));
+    memset(&sigevent, 0, sizeof(sigevent));
+    sigevent.sigev_notify = SIGEV_THREAD;
+    sigevent.sigev_notify_function = timer_callback;
+    sigevent.sigev_notify_attributes = nullptr;
+    if (timer_create(clock_id, &sigevent, timer) == 0) {
+      pthread_attr_destroy(&thread_attr);
+      return true;
+    }
+
     log::error("unable to create timer with clock {}: {}", clock_id, strerror(errno));
     if (clock_id == CLOCK_BOOTTIME_ALARM) {
       log::error(
diff --git a/system/stack/btu/main_thread.cc b/system/stack/btu/main_thread.cc
index 9bd84ae529d691bcc2ac1ad98265d86db219db1e..481806222a7470ef6b40fcd13273a6d2386c9fa1 100644
--- a/system/stack/btu/main_thread.cc
+++ b/system/stack/btu/main_thread.cc
@@ -71,7 +71,7 @@ void main_thread_start_up() {
   }
   if (!main_thread.EnableRealTimeScheduling()) {
 #if defined(__ANDROID__)
-    log::fatal("unable to enable real time scheduling");
+    log::error("unable to enable real time scheduling");
 #else
     log::error("unable to enable real time scheduling");
 #endif
